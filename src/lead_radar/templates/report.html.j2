<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Lead Radar · {{ request.query }}</title>
{% if embedded %}
{# Inside the web app the fonts are already cached; standalone files stay fully offline. #}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap">
{% endif %}
<style>
  :root {
    --bg: #f4f5f7; --surface: #ffffff; --surface-2: #f9fafb; --ink: #0d1117; --ink-2: #374151;
    --muted: #6b7280; --line: #e5e7eb; --line-2: #d1d5db; --row-hover: #fafbfc;
    --accent: #c8f34a; --accent-ink: #0d1117; --accent-text: #4d7c0f; --accent-soft: #f3fbd9;
    --hot: #e5432d; --hot-soft: #fdecea; --warm: #d97706; --warm-soft: #fdf3e1;
    --cold: #98a2b3; --cold-soft: #eef0f3; --track: #eceef1;
    --notice: #fff8e6; --notice-ink: #7a4b00; --notice-line: #f6e2b3;
    --shadow: 0 1px 2px rgb(16 24 40 / 0.04), 0 1px 3px rgb(16 24 40 / 0.06);
    --font: "Inter", ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --display: "Space Grotesk", "Inter", ui-sans-serif, system-ui, -apple-system, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0a0d12; --surface: #11161d; --surface-2: #0e1319; --ink: #e8eaed; --ink-2: #c4c9d1;
      --muted: #8b93a1; --line: #1f2630; --line-2: #2a323e; --row-hover: #141a22;
      --accent-text: #c8f34a; --accent-soft: #1d2410;
      --hot: #ff6b55; --hot-soft: #2a1512; --warm: #f5a524; --warm-soft: #2a1f0c;
      --cold: #6b7483; --cold-soft: #1a1f27; --track: #1f2630;
      --notice: #251d0b; --notice-ink: #f2d59a; --notice-line: #3a2e12;
      --shadow: none;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--ink); font: 14px/1.5 var(--font);
    -webkit-font-smoothing: antialiased; font-feature-settings: "cv11", "ss01";
  }
  a { color: inherit; }
  .wrap { max-width: 1320px; margin: 0 auto; padding: 40px 24px 56px; }
  .embedded .wrap { max-width: none; padding: 0 0 8px; }
  .icon { width: 15px; height: 15px; flex: none; stroke: currentColor; fill: none; stroke-width: 2;
          stroke-linecap: round; stroke-linejoin: round; vertical-align: -2px; }

  /* header (standalone file only) */
  .masthead { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; font: 600 14px var(--display); }
  .masthead .mark { width: 26px; height: 26px; border-radius: 8px; background: var(--ink); display: grid; place-items: center; }
  h1 { font: 700 34px/1.15 var(--display); letter-spacing: -0.025em; margin: 0 0 8px; text-wrap: balance; }
  .lede { color: var(--muted); margin: 0 0 28px; max-width: 70ch; }

  /* summary */
  .summary {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; overflow: hidden;
    background: var(--line); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow);
  }
  .kpi { background: var(--surface); padding: 18px 20px 16px; }
  .kpi .label { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; font-weight: 500; }
  .kpi .dot { width: 8px; height: 8px; border-radius: 50%; }
  .kpi b { display: block; font: 600 32px/1.1 var(--display); letter-spacing: -0.02em; margin-top: 6px;
           font-variant-numeric: tabular-nums; }
  .kpi.hot b { color: var(--hot); } .kpi.warm b { color: var(--warm); }
  .distribution { grid-column: 1 / -1; background: var(--surface); padding: 0 20px 18px; }
  .bar { display: flex; height: 8px; border-radius: 999px; overflow: hidden; background: var(--track); gap: 2px; }
  .bar span { display: block; height: 100%; }
  .meta-line { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 12px; color: var(--muted); font-size: 13px; }
  .meta-line b { color: var(--ink-2); font-weight: 600; font-variant-numeric: tabular-nums; }

  .note { color: var(--muted); font-size: 13px; margin: 14px 2px 0; display: flex; gap: 8px; align-items: flex-start; }
  .notice {
    display: flex; gap: 10px; margin: 16px 0 0; padding: 12px 16px; border-radius: 12px;
    background: var(--notice); color: var(--notice-ink); border: 1px solid var(--notice-line);
  }
  .notice ul { margin: 4px 0 0; padding-left: 18px; }
  .notice .icon { margin-top: 3px; }

  /* toolbar */
  .toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin: 28px 0 12px; }
  .search { position: relative; flex: 1 1 260px; max-width: 380px; }
  .search .icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--muted); }
  .search input {
    width: 100%; height: 40px; padding: 0 12px 0 36px; border-radius: 10px; border: 1px solid var(--line-2);
    background: var(--surface); color: var(--ink); font: inherit;
  }
  .search input::placeholder { color: var(--muted); }
  .segmented { display: inline-flex; padding: 3px; gap: 2px; border-radius: 11px; background: var(--track); }
  .chip {
    border: 0; background: transparent; color: var(--ink-2); font: 500 13px var(--font); cursor: pointer;
    padding: 7px 12px; border-radius: 8px; display: inline-flex; gap: 6px; align-items: center;
  }
  .chip .n { color: var(--muted); font-variant-numeric: tabular-nums; }
  .chip[aria-pressed=true] { background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
  .count { color: var(--muted); margin-left: auto; font-size: 13px; font-variant-numeric: tabular-nums; }

  /* table */
  .table-card { background: var(--surface); border: 1px solid var(--line); border-radius: 16px;
                box-shadow: var(--shadow); overflow-x: auto; }
  table { border-collapse: collapse; width: 100%; min-width: 860px; table-layout: fixed; }
  th, td { text-align: left; vertical-align: top; padding: 16px 14px; border-bottom: 1px solid var(--line); }
  th:first-child, td:first-child { padding-left: 18px; }
  tbody tr:last-child td { border-bottom: 0; }
  tbody tr:hover td { background: var(--row-hover); }
  thead th {
    position: sticky; top: 0; z-index: 1; background: var(--surface-2); padding-top: 11px; padding-bottom: 11px;
    font-size: 12px; font-weight: 600; color: var(--muted); white-space: nowrap;
  }
  th button { all: unset; cursor: pointer; display: inline-flex; gap: 4px; align-items: center; }
  th button::after { content: "↕"; opacity: 0.35; font-size: 11px; }
  th[aria-sort=ascending] button, th[aria-sort=descending] button { color: var(--ink); }
  th[aria-sort=ascending] button::after { content: "↑"; opacity: 1; }
  th[aria-sort=descending] button::after { content: "↓"; opacity: 1; }
  :focus-visible { outline: 2px solid var(--accent-text); outline-offset: 2px; }
  .search input:focus-visible { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px rgb(200 243 74 / 0.45); }

  .ring {
    --pct: 0; --c: var(--cold);
    width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
    background: conic-gradient(var(--c) calc(var(--pct) * 1%), var(--track) 0);
  }
  .ring b {
    width: 38px; height: 38px; border-radius: 50%; background: var(--surface); display: grid; place-items: center;
    font: 600 15px var(--display); font-variant-numeric: tabular-nums;
  }
  tbody tr:hover .ring b { background: var(--row-hover); }
  .ring.hot { --c: var(--hot); } .ring.warm { --c: var(--warm); }
  .tier { display: block; margin-top: 6px; width: 48px; text-align: center; font-size: 11px; font-weight: 600;
          letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
  .tier.hot { color: var(--hot); } .tier.warm { color: var(--warm); }

  .biz { min-width: 200px; }
  thead th:nth-child(1) { width: 84px; } thead th:nth-child(2) { width: 25%; }
  thead th:nth-child(3) { width: 184px; } thead th:nth-child(4) { width: 72px; }
  thead th:nth-child(5) { width: 84px; } thead th:nth-child(7) { width: 64px; }
  .name { font-weight: 600; font-size: 15px; line-height: 1.35; }
  .sub { color: var(--muted); font-size: 13px; margin-top: 2px; }
  .tags { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 8px; }
  .tag { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 999px;
         font-size: 12px; font-weight: 500; background: var(--cold-soft); color: var(--ink-2); white-space: nowrap; }
  .tag.bad { background: var(--hot-soft); color: var(--hot); }
  .tag.good { background: var(--accent-soft); color: var(--accent-text); }
  .tag .icon { width: 12px; height: 12px; }

  .contact { display: grid; gap: 6px; justify-items: start; min-width: 0; }
  .contact a, .contact .tag { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .contact a { display: inline-flex; gap: 8px; align-items: center; text-decoration: none; color: var(--ink-2); }
  .contact a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .contact .icon { color: var(--muted); }
  .num { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .rating { display: inline-flex; gap: 5px; align-items: center; font-weight: 600; }
  .rating .icon { fill: #f5a524; stroke: none; }
  .muted { color: var(--muted); }

  .why { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .why li { display: flex; gap: 10px; align-items: baseline; color: var(--ink-2); }
  .why .pts {
    flex: none; min-width: 36px; padding: 1px 0; border-radius: 6px; text-align: center;
    font: 600 12px var(--display); background: var(--track); color: var(--ink); font-variant-numeric: tabular-nums;
  }
  .why li:first-child .pts { background: var(--accent); color: var(--accent-ink); }
  .clean { color: var(--muted); display: inline-flex; gap: 6px; align-items: center; }

  .maps {
    display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 9px;
    border: 1px solid var(--line-2); color: var(--ink-2);
  }
  .maps:hover { border-color: var(--ink); color: var(--ink); }
  .empty { padding: 56px 24px; text-align: center; color: var(--muted); }
  footer { margin-top: 28px; color: var(--muted); font-size: 12px; }

  @media (max-width: 600px) {
    .summary { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    h1 { font-size: 26px; }
    .wrap { padding: 24px 16px 40px; }
  }
  @media print { .toolbar { display: none; } .table-card { overflow: visible; box-shadow: none; } }
</style>
</head>
<body{% if embedded %} class="embedded"{% endif %}>
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="i-phone" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></symbol>
  <symbol id="i-globe" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></symbol>
  <symbol id="i-calendar" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/><path d="m9 16 2 2 4-4"/></symbol>
  <symbol id="i-pin" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></symbol>
  <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></symbol>
  <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></symbol>
  <symbol id="i-alert" viewBox="0 0 24 24"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4M12 17h.01"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
  <symbol id="i-external" viewBox="0 0 24 24"><path d="M15 3h6v6M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></symbol>
</svg>
<div class="wrap">
  {% if not embedded %}
  <div class="masthead">
    <span class="mark"><svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="#c8f34a" stroke-width="2"/><circle cx="12" cy="12" r="4.5" fill="none" stroke="#c8f34a" stroke-width="2" opacity=".55"/><circle cx="12" cy="12" r="1.8" fill="#c8f34a"/></svg></span>
    Lead Radar
  </div>
  <header>
    <h1>{{ request.query }} in {{ request.locations | join(" · ") }}</h1>
    <p class="lede">Generated {{ result.generated_at.strftime("%Y-%m-%d %H:%M %Z") }}.
      Ranked by how likely each business is to need help with missed calls, online booking and review follow-up.</p>
  </header>
  {% endif %}

  {% set total = leads | length %}
  <section class="summary" aria-label="Summary">
    <div class="kpi"><span class="label">Businesses</span><b>{{ total }}</b></div>
    <div class="kpi hot"><span class="label"><span class="dot" style="background:var(--hot)"></span>Hot leads</span><b>{{ hot }}</b></div>
    <div class="kpi warm"><span class="label"><span class="dot" style="background:var(--warm)"></span>Warm leads</span><b>{{ warm }}</b></div>
    <div class="kpi"><span class="label"><span class="dot" style="background:var(--cold)"></span>Cold</span><b>{{ cold }}</b></div>
    <div class="distribution">
      {% if total %}
      <div class="bar" role="img" aria-label="{{ hot }} hot, {{ warm }} warm, {{ cold }} cold">
        {% if hot %}<span style="width:{{ (hot / total * 100) | round(2) }}%;background:var(--hot)"></span>{% endif %}
        {% if warm %}<span style="width:{{ (warm / total * 100) | round(2) }}%;background:var(--warm)"></span>{% endif %}
        {% if cold %}<span style="width:{{ (cold / total * 100) | round(2) }}%;background:var(--cold)"></span>{% endif %}
      </div>
      {% endif %}
      <div class="meta-line">
        <span><b>{{ result.stats.api_calls }}</b> SerpApi searches used</span>
        <span><b>{{ result.stats.cache_hits }}</b> served from cache</span>
        <span><b>{{ result.duplicates_removed }}</b> duplicates removed</span>
      </div>
    </div>
  </section>

  {% if result.resolved_locations %}
  <p class="note"><svg class="icon"><use href="#i-pin"/></svg>
    <span>Map centred on {% for typed, place in result.resolved_locations.items() %}{{ place }}{% if not loop.last %}; {% endif %}{% endfor %}.</span>
  </p>
  {% endif %}
  {% if result.stop_reason or result.warnings %}
  <div class="notice" role="status">
    <svg class="icon"><use href="#i-alert"/></svg>
    <div>
      {% if result.stop_reason %}<strong>Partial results.</strong> {{ result.stop_reason }}{% endif %}
      {% if result.warnings %}
      <ul>{% for warning in result.warnings %}<li>{{ warning }}</li>{% endfor %}</ul>
      {% endif %}
    </div>
  </div>
  {% endif %}
  {% if not with_reviews %}
  <p class="note"><svg class="icon"><use href="#i-alert"/></svg><span>Review signals (missed-call complaints, owner replies, rating trend) were not collected for this run.
    {% if embedded %}Run the search again with “Analyse latest reviews” turned on to include them.
    {% else %}Re-run with <code>--reviews</code> to include them.{% endif %}</span></p>
  {% endif %}

  {% if leads %}
  <div class="toolbar">
    <label class="search"><svg class="icon"><use href="#i-search"/></svg>
      <input type="search" id="q" placeholder="Filter by name, address, reason…" aria-label="Filter leads"></label>
    <div class="segmented" role="group" aria-label="Filter by tier">
      <button class="chip" data-tier="all" aria-pressed="true">All <span class="n">{{ total }}</span></button>
      <button class="chip" data-tier="hot" aria-pressed="false">Hot <span class="n">{{ hot }}</span></button>
      <button class="chip" data-tier="warm" aria-pressed="false">Warm <span class="n">{{ warm }}</span></button>
      <button class="chip" data-tier="cold" aria-pressed="false">Cold <span class="n">{{ cold }}</span></button>
    </div>
    <span class="count" id="count" aria-live="polite"></span>
  </div>

  <div class="table-card">
    <table id="leads">
      <thead>
        <tr>
          <th data-sort="num" aria-sort="descending"><button>Score</button></th>
          <th data-sort="text"><button>Business</button></th>
          <th>Contact</th>
          <th data-sort="num"><button>Rating</button></th>
          <th data-sort="num"><button>Reviews</button></th>
          <th>Why this score</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for lead in leads %}
        {% set b = lead.business %}
        <tr data-tier="{{ lead.tier.value }}">
          <td data-value="{{ lead.score }}">
            <div class="ring {{ lead.tier.value }}" style="--pct: {{ lead.score }}"><b>{{ lead.score }}</b></div>
            <span class="tier {{ lead.tier.value }}">{{ lead.tier.value }}</span>
          </td>
          <td class="biz" data-value="{{ b.name | lower }}">
            <div class="name">{{ b.name }}</div>
            <div class="sub">{{ b.category or "" }}</div>
            <div class="sub">{{ b.address or "" }}</div>
            {% if b.unclaimed_listing %}<div class="tags"><span class="tag bad">Unclaimed listing</span></div>{% endif %}
          </td>
          <td>
            <div class="contact">
              {% if b.phone %}<a class="num" href="tel:{{ b.phone | replace(' ', '') }}"><svg class="icon"><use href="#i-phone"/></svg>{{ b.phone }}</a>
              {% else %}<span class="tag bad">No phone</span>{% endif %}
              {% if b.website %}<a href="{{ b.website }}" target="_blank" rel="noopener noreferrer"><svg class="icon"><use href="#i-globe"/></svg>{{ b.website_domain }}</a>
              {% else %}<span><span class="tag bad">No website</span></span>{% endif %}
              {% if b.booking_link %}<a href="{{ b.booking_link }}" target="_blank" rel="noopener noreferrer"><span class="tag good"><svg class="icon"><use href="#i-calendar"/></svg>Books online</span></a>
              {% elif b.has_online_booking %}<span><span class="tag good"><svg class="icon"><use href="#i-calendar"/></svg>{{ b.booking_signals | join(", ") | replace("_", " ") }}</span></span>
              {% endif %}
            </div>
          </td>
          <td class="num" data-value="{{ b.rating if b.rating is not none else -1 }}">
            {% if b.rating is not none %}<span class="rating"><svg class="icon"><use href="#i-star"/></svg>{{ "%.1f" | format(b.rating) }}</span>{% else %}<span class="muted">No rating</span>{% endif %}
          </td>
          <td class="num" data-value="{{ b.review_count or 0 }}">{{ "{:,}".format(b.review_count or 0) }}</td>
          <td>
            {% if lead.reasons %}
            <ul class="why">
              {% for reason in lead.reasons %}
              <li><span class="pts">+{{ reason.points }}</span><span>{{ reason.message }}</span></li>
              {% endfor %}
            </ul>
            {% else %}<span class="clean"><svg class="icon"><use href="#i-check"/></svg>No automation gaps detected</span>{% endif %}
          </td>
          <td><a class="maps" href="{{ b.maps_url }}" target="_blank" rel="noopener noreferrer" title="Open in Google Maps" aria-label="Open {{ b.name }} in Google Maps"><svg class="icon"><use href="#i-pin"/></svg></a></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  <div class="table-card"><div class="empty">No businesses were found for this search.</div></div>
  {% endif %}

  {% if not embedded %}
  <footer>
    Lead Radar {{ version }} · Data from the SerpApi Google Maps API{% if with_reviews %} and Google Maps Reviews API{% endif %}.
    Scores are heuristics for prioritising outreach, not facts about a business.
  </footer>
  {% endif %}
</div>
<script>
(function () {
  var table = document.getElementById("leads");
  if (!table) return;
  var tbody = table.tBodies[0];
  var rows = Array.prototype.slice.call(tbody.rows);
  var query = document.getElementById("q");
  var count = document.getElementById("count");
  var chips = Array.prototype.slice.call(document.querySelectorAll(".chip"));
  var tier = "all";

  function applyFilter() {
    var needle = query.value.trim().toLowerCase();
    var shown = 0;
    rows.forEach(function (row) {
      var ok = (tier === "all" || row.dataset.tier === tier) &&
               (!needle || row.textContent.toLowerCase().indexOf(needle) !== -1);
      row.hidden = !ok;
      if (ok) shown += 1;
    });
    count.textContent = shown + " of " + rows.length + " shown";
  }

  chips.forEach(function (chip) {
    chip.addEventListener("click", function () {
      tier = chip.dataset.tier;
      chips.forEach(function (c) { c.setAttribute("aria-pressed", String(c === chip)); });
      applyFilter();
    });
  });
  query.addEventListener("input", applyFilter);

  Array.prototype.forEach.call(table.tHead.rows[0].cells, function (th, index) {
    var kind = th.dataset.sort;
    if (!kind) return;
    th.querySelector("button").addEventListener("click", function () {
      var ascending = th.getAttribute("aria-sort") === "descending";
      if (!th.hasAttribute("aria-sort")) ascending = kind === "text";
      Array.prototype.forEach.call(table.tHead.rows[0].cells, function (other) {
        other.removeAttribute("aria-sort");
      });
      th.setAttribute("aria-sort", ascending ? "ascending" : "descending");
      rows.sort(function (a, b) {
        var x = a.cells[index].dataset.value, y = b.cells[index].dataset.value;
        var diff = kind === "num" ? parseFloat(x) - parseFloat(y) : x.localeCompare(y);
        return ascending ? diff : -diff;
      });
      rows.forEach(function (row) { tbody.appendChild(row); });
    });
  });

  applyFilter();
})();
</script>
</body>
</html>
